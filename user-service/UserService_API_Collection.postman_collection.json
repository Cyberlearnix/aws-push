				{
					"name": "1. Send OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"test@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/email-auth/send-otp",
							"host": ["{{base_url}}"],
							"path": ["api", "email-auth", "send-otp"]
						}
					},
					"response": []
				},
